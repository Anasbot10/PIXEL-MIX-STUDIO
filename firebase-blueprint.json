{
  "entities": {
    "BusinessSettings": {
      "title": "BusinessSettings",
      "description": "Studio profile, payment coordinates, sequential numbering counters, and PDF preferences owned by a studio administrator.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "businessName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "businessType": { "type": "string", "maxLength": 80 },
        "industry": { "type": "string", "maxLength": 200 },
        "country": { "type": "string", "maxLength": 80 },
        "phone": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 120 },
        "instagram": { "type": "string", "maxLength": 200 },
        "address": { "type": "string", "maxLength": 400 },
        "logoDataUrl": { "type": "string", "maxLength": 120000 },
        "upiId": { "type": "string", "maxLength": 120 },
        "bankName": { "type": "string", "maxLength": 120 },
        "bankAccountHolder": { "type": "string", "maxLength": 120 },
        "bankAccountNumber": { "type": "string", "maxLength": 60 },
        "bankIfsc": { "type": "string", "maxLength": 40 },
        "bankBranch": { "type": "string", "maxLength": 120 },
        "bankSwift": { "type": "string", "maxLength": 40 },
        "defaultCurrency": { "type": "string", "enum": ["INR", "USD", "AED", "SAR", "GBP", "EUR"] },
        "invoicePrefix": { "type": "string", "minLength": 1, "maxLength": 16 },
        "quotationPrefix": { "type": "string", "minLength": 1, "maxLength": 16 },
        "receiptPrefix": { "type": "string", "minLength": 1, "maxLength": 16 },
        "nextInvoiceNumber": { "type": "number" },
        "nextQuotationNumber": { "type": "number" },
        "nextReceiptNumber": { "type": "number" },
        "nextCustomerNumber": { "type": "number" },
        "nextProjectNumber": { "type": "number" },
        "nextExpenseNumber": { "type": "number" },
        "defaultTerms": { "type": "string", "maxLength": 2000 },
        "defaultPaymentInstructions": { "type": "string", "maxLength": 1000 },
        "pdfAccentColor": { "type": "string", "maxLength": 20 },
        "pdfFooterNote": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "businessName", "businessType", "industry", "country", "phone", "email",
        "instagram", "address", "logoDataUrl", "upiId", "bankName", "bankAccountHolder",
        "bankAccountNumber", "bankIfsc", "bankBranch", "bankSwift", "defaultCurrency",
        "invoicePrefix", "quotationPrefix", "receiptPrefix", "nextInvoiceNumber",
        "nextQuotationNumber", "nextReceiptNumber", "nextCustomerNumber", "nextProjectNumber",
        "nextExpenseNumber", "defaultTerms", "defaultPaymentInstructions", "pdfAccentColor",
        "pdfFooterNote", "createdAt", "updatedAt"
      ]
    },
    "Customer": {
      "title": "Customer",
      "description": "CRM client record with contact info, classification, and notes.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerCode": { "type": "string", "minLength": 1, "maxLength": 40 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 400 },
        "companyName": { "type": "string", "maxLength": 120 },
        "customerType": { "type": "string", "enum": ["Individual", "Business", "Agency", "Startup", "Organization"] },
        "notes": { "type": "string", "maxLength": 1000 },
        "registrationDate": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "customerCode", "fullName", "phone", "email", "address",
        "companyName", "customerType", "notes", "registrationDate", "createdAt", "updatedAt"
      ]
    },
    "ServiceItem": {
      "title": "ServiceItem",
      "description": "Creative service offering with editable baseline price and delivery timeline.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 600 },
        "defaultPrice": { "type": "number" },
        "currency": { "type": "string", "enum": ["INR", "USD", "AED", "SAR", "GBP", "EUR"] },
        "estimatedDelivery": { "type": "string", "maxLength": 80 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "name", "description", "defaultPrice", "currency",
        "estimatedDelivery", "isActive", "createdAt", "updatedAt"
      ]
    },
    "Project": {
      "title": "Project",
      "description": "Creative project tracked from start to completion with linked customer, service, quotation, and invoice.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectCode": { "type": "string", "minLength": 1, "maxLength": 40 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "projectName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "serviceId": { "type": "string", "maxLength": 128 },
        "serviceName": { "type": "string", "maxLength": 120 },
        "startDate": { "type": "string", "maxLength": 20 },
        "deadline": { "type": "string", "maxLength": 20 },
        "budget": { "type": "number" },
        "currency": { "type": "string", "enum": ["INR", "USD", "AED", "SAR", "GBP", "EUR"] },
        "status": { "type": "string", "enum": ["New", "In Progress", "Waiting for Customer", "Completed", "Cancelled"] },
        "progress": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1500 },
        "linkedQuotationId": { "type": "string", "maxLength": 128 },
        "linkedInvoiceId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "projectCode", "customerId", "customerName", "projectName", "serviceId",
        "serviceName", "startDate", "deadline", "budget", "currency", "status", "progress",
        "notes", "linkedQuotationId", "linkedInvoiceId", "createdAt", "updatedAt"
      ]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "Commercial quotation with line items, discount, validity date, and conversion tracking.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "quotationNumber": { "type": "string", "minLength": 1, "maxLength": 40 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "customerEmail": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 40 },
        "customerAddress": { "type": "string", "maxLength": 400 },
        "issueDate": { "type": "string", "maxLength": 20 },
        "validityDate": { "type": "string", "maxLength": 20 },
        "currency": { "type": "string", "enum": ["INR", "USD", "AED", "SAR", "GBP", "EUR"] },
        "exchangeRate": { "type": "number" },
        "exchangeRateSource": { "type": "string", "maxLength": 120 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discountType": { "type": "string", "enum": ["fixed", "percent"] },
        "discountValue": { "type": "number" },
        "discountAmount": { "type": "number" },
        "total": { "type": "number" },
        "totalInr": { "type": "number" },
        "status": { "type": "string", "enum": ["Draft", "Sent", "Accepted", "Rejected", "Expired"] },
        "notes": { "type": "string", "maxLength": 1500 },
        "terms": { "type": "string", "maxLength": 2000 },
        "convertedInvoiceId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "quotationNumber", "customerId", "customerName", "customerEmail",
        "customerPhone", "customerAddress", "issueDate", "validityDate", "currency",
        "exchangeRate", "exchangeRateSource", "items", "subtotal", "discountType",
        "discountValue", "discountAmount", "total", "totalInr", "status", "notes",
        "terms", "convertedInvoiceId", "createdAt", "updatedAt"
      ]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Non-GST commercial invoice with automatic balance tracking linked to payments.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "invoiceNumber": { "type": "string", "minLength": 1, "maxLength": 40 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "customerEmail": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 40 },
        "customerAddress": { "type": "string", "maxLength": 400 },
        "issueDate": { "type": "string", "maxLength": 20 },
        "dueDate": { "type": "string", "maxLength": 20 },
        "currency": { "type": "string", "enum": ["INR", "USD", "AED", "SAR", "GBP", "EUR"] },
        "exchangeRate": { "type": "number" },
        "exchangeRateSource": { "type": "string", "maxLength": 120 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discountType": { "type": "string", "enum": ["fixed", "percent"] },
        "discountValue": { "type": "number" },
        "discountAmount": { "type": "number" },
        "grandTotal": { "type": "number" },
        "grandTotalInr": { "type": "number" },
        "amountPaid": { "type": "number" },
        "amountPaidInr": { "type": "number" },
        "balanceDue": { "type": "number" },
        "balanceDueInr": { "type": "number" },
        "status": { "type": "string", "enum": ["Draft", "Unpaid", "Partially Paid", "Paid", "Overdue", "Cancelled"] },
        "notes": { "type": "string", "maxLength": 1500 },
        "paymentInstructions": { "type": "string", "maxLength": 1000 },
        "sourceQuotationId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "invoiceNumber", "customerId", "customerName", "customerEmail",
        "customerPhone", "customerAddress", "issueDate", "dueDate", "currency",
        "exchangeRate", "exchangeRateSource", "items", "subtotal", "discountType",
        "discountValue", "discountAmount", "grandTotal", "grandTotalInr", "amountPaid",
        "amountPaidInr", "balanceDue", "balanceDueInr", "status", "notes",
        "paymentInstructions", "sourceQuotationId", "createdAt", "updatedAt"
      ]
    },
    "Payment": {
      "title": "Payment",
      "description": "Recorded payment and studio receipt linked to an invoice with full forex accounting.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "receiptNumber": { "type": "string", "minLength": 1, "maxLength": 40 },
        "invoiceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "invoiceNumber": { "type": "string", "minLength": 1, "maxLength": 40 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "paymentDate": { "type": "string", "maxLength": 20 },
        "paymentType": { "type": "string", "enum": ["Advance", "Partial", "Full"] },
        "paymentMethod": { "type": "string", "enum": ["UPI", "Google Pay", "PhonePe", "Bank Transfer", "Cash", "International Transfer", "Other"] },
        "originalCurrency": { "type": "string", "enum": ["INR", "USD", "AED", "SAR", "GBP", "EUR"] },
        "originalAmount": { "type": "number" },
        "exchangeRate": { "type": "number" },
        "exchangeRateSource": { "type": "string", "maxLength": 120 },
        "inrEquivalent": { "type": "number" },
        "transferFees": { "type": "number" },
        "netAmountReceivedInr": { "type": "number" },
        "transactionReference": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "receiptNumber", "invoiceId", "invoiceNumber", "customerId", "customerName",
        "paymentDate", "paymentType", "paymentMethod", "originalCurrency", "originalAmount",
        "exchangeRate", "exchangeRateSource", "inrEquivalent", "transferFees",
        "netAmountReceivedInr", "transactionReference", "notes", "createdAt", "updatedAt"
      ]
    },
    "Expense": {
      "title": "Expense",
      "description": "Business expense entry with category, vendor, forex conversion, and optional receipt attachment.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "expenseCode": { "type": "string", "minLength": 1, "maxLength": 40 },
        "date": { "type": "string", "maxLength": 20 },
        "category": { "type": "string", "enum": ["Software Subscriptions", "Internet", "Equipment", "Marketing", "Advertising", "Travel", "Printing", "Office Expenses", "Other"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "originalCurrency": { "type": "string", "enum": ["INR", "USD", "AED", "SAR", "GBP", "EUR"] },
        "originalAmount": { "type": "number" },
        "exchangeRate": { "type": "number" },
        "exchangeRateSource": { "type": "string", "maxLength": 120 },
        "inrEquivalent": { "type": "number" },
        "transferFees": { "type": "number" },
        "netAmountInr": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["UPI", "Google Pay", "PhonePe", "Bank Transfer", "Cash", "International Transfer", "Other"] },
        "vendor": { "type": "string", "maxLength": 120 },
        "referenceNumber": { "type": "string", "maxLength": 120 },
        "attachmentUrl": { "type": "string", "maxLength": 150000 },
        "attachmentName": { "type": "string", "maxLength": 160 },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "expenseCode", "date", "category", "description", "originalCurrency",
        "originalAmount", "exchangeRate", "exchangeRateSource", "inrEquivalent",
        "transferFees", "netAmountInr", "paymentMethod", "vendor", "referenceNumber",
        "attachmentUrl", "attachmentName", "notes", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/settings/{ownerId}": {
      "schema": { "$ref": "#/entities/BusinessSettings" },
      "description": "Studio business settings, banking details, and sequential document counters."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Studio customer directory and CRM profiles."
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/ServiceItem" },
      "description": "Editable creative services and price list."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Creative project pipeline linked to customers, services, quotations, and invoices."
    },
    "/quotations/{quotationId}": {
      "schema": { "$ref": "#/entities/Quotation" },
      "description": "Commercial quotations with line items and conversion status."
    },
    "/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Non-GST commercial invoices with live payment balance accounting."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Recorded client payments and studio-generated receipts."
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Business expense ledger with multi-currency tracking."
    }
  }
}
